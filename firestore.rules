rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles & fan data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == '14krokodilo14@gmail.com');
    }

    // Connection validation test
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}

